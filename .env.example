APP_NAME=StoreManagement
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000,::1,DESKTOP-BP6OCAN,DESKTOP-BP6OCAN:80,192.168.0.114,192.168.0.114:80
SANCTUM_TOKEN_EXPIRATION=60

# Use different usernames and passwords of at least 10 characters.
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Superadmin
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=storemanagement
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

SANCTUM_TOKEN_PREFIX=

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"